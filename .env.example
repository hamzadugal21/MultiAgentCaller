# Django
DJANGO_READ_DOT_ENV=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL
DB_NAME=multiagent_recruitment
DB_USER=multiagent_app
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Production may use one private PostgreSQL URL instead of the DB_* values above.
DATABASE_URL=
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60

# Redis / production WebSockets
REDIS_URL=redis://localhost:6379/0

# Production HTTPS
DJANGO_TRUST_PROXY_HEADERS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Production email
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional local-only Faster-Whisper transcription. Models remain outside Git.
WHISPER_MODEL_PATH=var/models/whisper/base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_MAX_AUDIO_SECONDS=60
WHISPER_MAX_UPLOAD_BYTES=2097152
WHISPER_TRANSCRIPTION_RATE_LIMIT=5
WHISPER_TRANSCRIPTION_RATE_WINDOW_SECONDS=300

# Optional local-only Piper Plus speech synthesis. The selected multilingual
# English-capable voice and its adjacent .onnx.json configuration remain outside Git.
PIPER_MODEL_PATH=var/models/piper/tsukuyomi-zs-v1/releases/zs-v1/tsukuyomi.onnx
